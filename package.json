{
  "name": "clio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clio: a staff ride at software speed. Historical battles replayed by a swarm of Drex agents built from primary sources.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,blue \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "web": "vite",
    "build": "vite build",
    "personas": "tsx --env-file-if-exists=.env server/scripts/personas.ts",
    "fidelity": "tsx --env-file-if-exists=.env server/scripts/fidelity.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
